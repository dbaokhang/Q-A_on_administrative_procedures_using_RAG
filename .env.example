# Copy to .env and fill in your values: cp .env.example .env
# .env is gitignored — never commit real keys.

# ---- Mô hình sinh câu trả lời ----
# LLM provider: "gemini" or "ollama".
# If unset: gemini when GOOGLE_API_KEY is present, otherwise ollama.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional: override the model (defaults: gemini-3.5-flash-lite / qwen3:8b)
# LLM_MODEL=gemini-3.5-flash-lite
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: LLM query rewriting before retrieval: auto (default) | true | false
# auto = always with Gemini; with Ollama only for follow-up questions and English / unaccented questions.
# QUERY_REWRITE=auto

# ---- Truy xuất (Bảng 2.8 – 2.9 báo cáo) ----
# Embedding: auto (custom transformer → fine-tuned E5 → E5 base) | finetuned-e5 | e5-base | bge-m3 | custom
# bge-m3 cần ~2,3 GB RAM; mỗi mô hình có collection riêng nên đổi mô hình sẽ đánh chỉ mục lại (không trộn vector).
# EMBEDDING_MODEL=auto
# Vector database: qdrant (mặc định, chế độ cục bộ trong qdrant_data/) | faiss (phương án so sánh)
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333     # dùng Qdrant server khi chạy đồng thời Streamlit + API + đánh giá
# Hợp nhất sparse + dense: rrf (mặc định) | weighted (cộng điểm 50/50 — cấu hình cũ)
# FUSION_METHOD=rrf
# RRF_K=60
# K_SPARSE=20
# K_DENSE=20
# K_FINAL=7
# USE_RERANKER=true
# RERANK_POOL=24                       # số ứng viên đưa vào Cross-Encoder (đánh đổi độ trễ / chất lượng)
# MIN_RELEVANCE_SCORE=-4.0             # điểm Cross-Encoder tối thiểu; thấp hơn → "chưa đủ căn cứ"

# ---- Phân quyền và nhật ký ----
# Khóa ký token đăng nhập (bắt buộc đặt khi triển khai; để trống thì token mất hiệu lực mỗi lần khởi động lại)
# APP_SECRET=chuoi-ngau-nhien-du-dai
# TOKEN_TTL_SECONDS=28800
# RATE_LIMIT_PER_MINUTE=30             # giới hạn /chat cho người dùng công khai, theo địa chỉ IP
# LOG_QUESTION_TEXT=false              # true: lưu câu hỏi đã che dữ liệu cá nhân vào data/logs (chỉ khi thử nghiệm)

# ---- Langfuse (tùy chọn) — off unless both keys are set ----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com    # US region: https://us.cloud.langfuse.com
